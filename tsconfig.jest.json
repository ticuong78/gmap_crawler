{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.jest.tsbuildinfo",
    "target": "es2022",
    "module": "es2022",
    "composite": true,
    "types": ["jest", "node"],
    "outDir": "dist-jest",
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron",
    "dist-electron-test",
    "tests/archive"
  ]
}
