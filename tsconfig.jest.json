{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.jest.tsbuildinfo",
    "target": "ES2017",
    "module": "CommonJS",
    "composite": true,
    "types": ["jest", "node"],
    "outDir": "dist-jest",
    "isolatedModules": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-electron", "dist-electron-test"]
}
