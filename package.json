{
  "name": "gmap_crawler",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "main": "dist-electron/src/main/index.cjs",
  "author": {
    "name": "Lê Phạm Hùng Cường",
    "email": "cuongdayne17@gmail.com",
    "url": "https://facebook.com/hades.rander"
  },
  "description": "Ứng dụng dùng để Scrape thông tin thông qua Gmap bằng cách vận dụng tính năng Chromium của Electron",
  "scripts": {
    "vite:dev": "vite",
    "elec:dev": "tsc -b tsconfig.electron.json --force && electron --inspect=9222 dist-electron/src/main/index.cjs",
    "clean": "rimraf dist dist-electron",
    "dev": "yarn clean && concurrently \"yarn vite:dev\" \"yarn elec:dev\""
  },
  "dependencies": {
    "puppeteer-core": "^24.40.0",
    "puppeteer-in-electron": "^3.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@electron-forge/plugin-vite": "^7.11.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "electron": "^41.0.3",
    "electron-forge": "^5.2.4",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.1"
  }
}
